<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri='http://java.sun.com/jsp/jstl/core' prefix='c'%>
<%--
    쿠팡 파트너스 다이나믹 배너 설정.
    파트너스 관리페이지 > 링크 생성 > 다이나믹 배너에서 배너 생성 후,
    발급된 스크립트의 id 숫자와 trackingCode(AF로 시작) 값을 아래에 입력하면 활성화된다.
    PC용 id와 trackingCode가 비어 있는 동안에는 아무것도 렌더링하지 않는다.
    모바일용 id가 비어 있으면 모바일에서도 PC용 배너를 사용한다.
--%>
<c:set var="coupangDynamicTrackingCode" value="AF8324470" />
<c:set var="coupangDynamicPcId" value="1002422" />
<c:set var="coupangDynamicPcWidth" value="680" />
<c:set var="coupangDynamicPcHeight" value="140" />
<c:set var="coupangDynamicMobileId" value="1002496" />
<c:set var="coupangDynamicMobileWidth" value="300" />
<c:set var="coupangDynamicMobileHeight" value="250" />

<c:if test="${not empty coupangDynamicPcId and not empty coupangDynamicTrackingCode}">
<style>
.coupang-dynamic-ad {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
    overflow: hidden; /* 화면보다 넓은 고정폭 iframe이 레이아웃을 밀지 않도록 클리핑 */
    margin: 20px 0;
}
.coupang-dynamic-ad-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: ${coupangDynamicPcHeight}px;
}
@media (max-width: 768px) {
    .coupang-dynamic-ad-frame {
        min-height: ${coupangDynamicMobileHeight}px;
    }
}
</style>
<div class="coupang-dynamic-ad"
     data-pc-id="${coupangDynamicPcId}"
     data-pc-width="${coupangDynamicPcWidth}"
     data-pc-height="${coupangDynamicPcHeight}"
     data-mobile-id="${coupangDynamicMobileId}"
     data-mobile-width="${coupangDynamicMobileWidth}"
     data-mobile-height="${coupangDynamicMobileHeight}"
     data-tracking-code="${coupangDynamicTrackingCode}">
    <div class="coupang-dynamic-ad-frame"></div>
    <div class="coupang-banner-text">
        <p>사이트 내 쿠팡 배너는 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.</p>
    </div>
</div>
<script>
    <%-- 외부 g.js의 document.write가 페이지 파싱을 막지 않도록, 페이지 로드 후 직접 iframe을 생성한다. --%>
    (function() {
        var containerEl = document.currentScript.previousElementSibling;
        var frameHostEl = containerEl.querySelector('.coupang-dynamic-ad-frame');
        var pageLoaded = document.readyState === 'complete';
        var nearViewport = false;
        var rendered = false;
        var observer = null;
        var renderDelayId = null;
        var renderIdleId = null;
        var monitoringUserInput = false;
        var AD_LOAD_QUIET_MILLIS = 800;

        function stopMonitoringUserInput() {
            if (!monitoringUserInput) {
                return;
            }
            monitoringUserInput = false;
            document.removeEventListener('pointerdown', postponeAdForUserInput);
            document.removeEventListener('keydown', postponeAdForUserInput);
            window.removeEventListener('wheel', postponeAdForUserInput);
            window.removeEventListener('touchmove', postponeAdForUserInput);
            window.removeEventListener('scroll', postponeAdForUserInput);
        }

        function cancelScheduledAdRender() {
            if (renderDelayId !== null) {
                window.clearTimeout(renderDelayId);
                renderDelayId = null;
            }
            if (renderIdleId !== null && 'cancelIdleCallback' in window) {
                window.cancelIdleCallback(renderIdleId);
                renderIdleId = null;
            }
        }

        function renderAd() {
            if (rendered || !pageLoaded || !nearViewport || !containerEl.isConnected) {
                return;
            }
            rendered = true;
            renderIdleId = null;
            cancelScheduledAdRender();
            stopMonitoringUserInput();
            if (observer) {
                observer.disconnect();
            }

            var useMobile = containerEl.dataset.mobileId
                    && window.matchMedia('(max-width: 768px)').matches;
            var id = useMobile ? containerEl.dataset.mobileId : containerEl.dataset.pcId;
            var width = useMobile ? containerEl.dataset.mobileWidth : containerEl.dataset.pcWidth;
            var height = useMobile ? containerEl.dataset.mobileHeight : containerEl.dataset.pcHeight;
            var iframeEl = document.createElement('iframe');
            var adSrc = 'https://ads-partners.coupang.com/widgets.html'
                    + '?id=' + encodeURIComponent(id)
                    + '&template=carousel'
                    + '&trackingCode=' + encodeURIComponent(containerEl.dataset.trackingCode)
                    + '&subId=&width=' + encodeURIComponent(width)
                    + '&height=' + encodeURIComponent(height)
                    + '&tsource=';

            iframeEl.width = width;
            iframeEl.height = height;
            iframeEl.setAttribute('frameborder', '0');
            iframeEl.setAttribute('scrolling', 'no');
            iframeEl.setAttribute('referrerpolicy', 'unsafe-url');
            iframeEl.setAttribute('loading', 'lazy');
            iframeEl.setAttribute('fetchpriority', 'low');
            iframeEl.title = '쿠팡 파트너스 상품 광고';
            iframeEl.src = adSrc;
            frameHostEl.appendChild(iframeEl);
        }

        function renderAdWhenIdle() {
            renderDelayId = null;
            if (rendered || !pageLoaded || !nearViewport || !containerEl.isConnected) {
                return;
            }
            if ('requestIdleCallback' in window) {
                renderIdleId = window.requestIdleCallback(renderAd);
                return;
            }
            renderAd();
        }

        function startMonitoringUserInput() {
            if (monitoringUserInput) {
                return;
            }
            monitoringUserInput = true;
            document.addEventListener('pointerdown', postponeAdForUserInput, { passive: true });
            document.addEventListener('keydown', postponeAdForUserInput);
            window.addEventListener('wheel', postponeAdForUserInput, { passive: true });
            window.addEventListener('touchmove', postponeAdForUserInput, { passive: true });
            window.addEventListener('scroll', postponeAdForUserInput, { passive: true });
        }

        function scheduleAdRender() {
            if (rendered || !pageLoaded || !nearViewport || !containerEl.isConnected) {
                return;
            }
            cancelScheduledAdRender();
            startMonitoringUserInput();
            renderDelayId = window.setTimeout(renderAdWhenIdle, AD_LOAD_QUIET_MILLIS);
        }

        function postponeAdForUserInput() {
            if (renderDelayId !== null || renderIdleId !== null) {
                scheduleAdRender();
            }
        }

        function markPageLoaded() {
            pageLoaded = true;
            scheduleAdRender();
        }

        if (!pageLoaded) {
            window.addEventListener('load', markPageLoaded, { once: true });
        }

        if ('IntersectionObserver' in window) {
            observer = new IntersectionObserver(function(entries) {
                var entry = entries[entries.length - 1];
                nearViewport = Boolean(entry && entry.isIntersecting);
                if (nearViewport) {
                    scheduleAdRender();
                } else {
                    cancelScheduledAdRender();
                    stopMonitoringUserInput();
                }
            }, { rootMargin: '100px 0px' });
            observer.observe(containerEl);
        } else {
            nearViewport = true;
            scheduleAdRender();
        }
    })();
</script>
</c:if>
