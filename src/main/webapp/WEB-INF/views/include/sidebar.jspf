<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<style>
#toggleButton {
    display: none; /* 모바일 환경에서 토글 버튼 숨김 처리 */
}
.sidebar {
    width: 100%;
    height: 100%;
}
@media screen and (max-width: 600px) {
    .sidebar {
        width: 100%;
        overflow: hidden; /* 오버플로우 숨김 처리 */
    }
}
.menu-content {
    display: none; /* 초기에 모든 메뉴 내용을 숨김 처리 */
}
.menu-header {
    cursor: pointer;
}
.basic-menu li {
    margin: 0.55rem 0.35rem;
    line-height: 1.3;
}
.menu-content a {
    display: inline-block;
    max-width: 100%;
}
@media screen and (max-width: 600px) {
    .basic-menu li {
        margin: 0.32rem 0;
    }
    .menu-header {
        font-size: 1rem;
        padding: 6px 4px;
    }
    .menu-content ul {
        padding-left: 0.35rem;
        margin: 0;
    }
    .menu-content a {
        display: inline-block;
        font-size: 0.96rem;
        line-height: 1.3;
    }
}
@media screen and (min-width: 769px) and (max-width: 1024px) {
    .basic-menu li {
        margin: 0.42rem 0.28rem;
    }
    .menu-header {
        font-size: 1rem;
        padding: 6px 4px;
    }
    .menu-content ul {
        padding-left: 0.35rem;
        margin: 0;
    }
    .menu-content a {
        display: inline-block;
        font-size: 0.95rem;
        line-height: 1.3;
    }
}
</style>

<div class="sc-col-3">
    <div id="sidebar" class="sidebar">
        <fieldset id="basicMenu" class="basic-menu">
            <legend><button type="button" class="menu-header" aria-expanded="true" aria-controls="basicMenuContent" onclick="toggleMenu('basicMenuContent')">커뮤니티 <span aria-hidden="true">⌄</span></button></legend>
            <div id="basicMenuContent" class="menu-content" style="display: block;">
                <ul>
                    <li><a href="/" accesskey="n">둘러보기(N)</a></li>
                    <li><a href="/boards/noticeboard">공지사항</a></li>
                    <li><a href="/boards/videolinkboard">영상자료실</a></li>
                    <li><a href="/boards/promotionboard">추천 및 홍보</a></li>
                    <li><a href="/boards/funboard">꿀잼놀이터</a></li>
                </ul>
            </div>
        </fieldset>
        <fieldset id="strategyMenu" class="menu-section">
            <legend><button type="button" class="menu-header" aria-expanded="false" aria-controls="strategyMenuContent" onclick="toggleMenu('strategyMenuContent')">공략게시판 <span aria-hidden="true">⌄</span></button></legend>
            <div id="strategyMenuContent" class="menu-content">
                <ul>
                    <li><a href="/boards/tvszboard" class="sc-menu-link sc-menu-link--terran">테저전 게시판</a></li>
                    <li><a href="/boards/tvspboard" class="sc-menu-link sc-menu-link--terran">테프전 게시판</a></li>
                    <li><a href="/boards/tvstboard" class="sc-menu-link sc-menu-link--terran">테테전 게시판</a></li>
                    <li><a href="/boards/zvstboard" class="sc-menu-link sc-menu-link--zerg">저테전 게시판</a></li>
                    <li><a href="/boards/zvspboard" class="sc-menu-link sc-menu-link--zerg">저프전 게시판</a></li>
                    <li><a href="/boards/zvszboard" class="sc-menu-link sc-menu-link--zerg">저저전 게시판</a></li>
                    <li><a href="/boards/pvstboard" class="sc-menu-link sc-menu-link--protoss">프테전 게시판</a></li>
                    <li><a href="/boards/pvszboard" class="sc-menu-link sc-menu-link--protoss">프저전 게시판</a></li>
                    <li><a href="/boards/pvspboard" class="sc-menu-link sc-menu-link--protoss">프프전 게시판</a></li>
                    <li><a href="/boards/teamplayguideboard">팀플 게시판</a></li>
                    <li><a href="/boards/tipboard" accesskey="t">꿀팁보급고(T)</a></li>
                </ul>
            </div>
        </fieldset>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 데스크톱은 두 메뉴를 펼친다. 모바일은 공략게시판에서는 공략게시판만,
    // 그 밖의 페이지에서는 커뮤니티만 펼쳐 본문 접근을 빠르게 한다.
    var openAll = window.innerWidth > 768;
    var openMenuId = isStrategyBoardPage() ? 'strategyMenuContent' : 'basicMenuContent';
    document.querySelectorAll('.menu-content').forEach(function(menu) {
        menu.style.display = (openAll || menu.id === openMenuId) ? "block" : "none";
    });
    syncMenuExpandedState();
});

function isStrategyBoardPage() {
    var path = window.location.pathname;
    return Array.prototype.some.call(
        document.querySelectorAll('#strategyMenuContent a[href^="/boards/"]'),
        function(link) {
            var boardPath = link.getAttribute('href');
            return path === boardPath || path.indexOf(boardPath + '/') === 0;
        });
}

function syncMenuExpandedState() {
    document.querySelectorAll('.menu-header[aria-controls]').forEach(function(button) {
        var menu = document.getElementById(button.getAttribute('aria-controls'));
        button.setAttribute('aria-expanded', String(menu.style.display === 'block'));
    });
}

function toggleMenu(menuId) {
    var menu = document.getElementById(menuId);

    document.querySelectorAll('.menu-content').forEach(function(otherMenu) {
        if (otherMenu.id !== menuId) {
            otherMenu.style.display = 'none'; // 다른 메뉴 숨기기
        }
    });

    // 현재 클릭한 메뉴의 표시 상태 토글
    menu.style.display = menu.style.display === "block" ? "none" : "block";
    syncMenuExpandedState();
}
</script>
