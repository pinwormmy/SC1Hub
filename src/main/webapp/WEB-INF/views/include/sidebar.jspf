<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<style>
#toggleButton {
    display: none; /* 모바일 환경에서 토글 버튼 숨김 처리 */
}
.sidebar {
    width: 100%;
    height: 100%;
}
@media screen and (max-width: 600px) {
    .sidebar {
        width: 100%;
        overflow: hidden; /* 오버플로우 숨김 처리 */
    }
}
.menu-content {
    display: none; /* 초기에 모든 메뉴 내용을 숨김 처리 */
}
.menu-toggle-hint {
    display: block; /* 토글 힌트 항상 표시 */
    color: var(--sc-text-dim);
    text-align: center;
    margin: 0 0 0.25rem;
    font-size: 0.82rem;
}
.menu-header {
    cursor: pointer;
}
.basic-menu li {
    margin: 0.55rem 0.35rem;
    line-height: 1.3;
}
.menu-content a {
    display: inline-block;
    max-width: 100%;
}
@media screen and (max-width: 600px) {
    .basic-menu li {
        margin: 0.32rem 0;
    }
    .menu-header {
        font-size: 1rem;
        padding: 6px 4px;
    }
    .menu-toggle-hint {
        font-size: 12px;
    }
    .menu-content ul {
        padding-left: 0.35rem;
        margin: 0;
    }
    .menu-content a {
        display: inline-block;
        font-size: 0.96rem;
        line-height: 1.3;
    }
}
@media screen and (min-width: 769px) and (max-width: 1024px) {
    .basic-menu li {
        margin: 0.42rem 0.28rem;
    }
    .menu-header {
        font-size: 1rem;
        padding: 6px 4px;
    }
    .menu-toggle-hint {
        font-size: 13px;
    }
    .menu-content ul {
        padding-left: 0.35rem;
        margin: 0;
    }
    .menu-content a {
        display: inline-block;
        font-size: 0.95rem;
        line-height: 1.3;
    }
}
</style>

<div class="sc-col-3">
    <div id="sidebar" class="sidebar">
        <fieldset id="basicMenu" class="basic-menu">
            <legend><button type="button" class="menu-header" aria-expanded="true" aria-controls="basicMenuContent" onclick="toggleMenu('basicMenuContent')">커뮤니티 <span aria-hidden="true">⌄</span></button></legend>
            <p class="menu-toggle-hint">게시판 펼치기</p>
            <div id="basicMenuContent" class="menu-content" style="display: block;">
                <ul>
                    <li><a href="/" accesskey="n">0. 둘러보기(N)</a></li>
                    <li><a href="/boards/noticeboard">1. 공지사항</a></li>
                    <li><a href="/boards/videolinkboard">2. 영상자료실</a></li>
                    <li><a href="/boards/promotionboard">3. 추천 및 홍보</a></li>
                    <li><a href="/boards/funboard">4. 꿀잼놀이터</a></li>
                </ul>
            </div>
        </fieldset>
        <fieldset id="strategyMenu" class="menu-section">
            <legend><button type="button" class="menu-header" aria-expanded="false" aria-controls="strategyMenuContent" onclick="toggleMenu('strategyMenuContent')">공략게시판 <span aria-hidden="true">⌄</span></button></legend>
            <p class="menu-toggle-hint">게시판 펼치기</p>
            <div id="strategyMenuContent" class="menu-content">
                <ul>
                    <li><a href="/boards/tvszboard" class="sc-menu-link sc-menu-link--terran">10. 테저전 게시판</a></li>
                    <li><a href="/boards/tvspboard" class="sc-menu-link sc-menu-link--terran">11. 테프전 게시판</a></li>
                    <li><a href="/boards/tvstboard" class="sc-menu-link sc-menu-link--terran">12. 테테전 게시판</a></li>
                    <li><a href="/boards/zvstboard" class="sc-menu-link sc-menu-link--zerg">13. 저테전 게시판</a></li>
                    <li><a href="/boards/zvspboard" class="sc-menu-link sc-menu-link--zerg">14. 저프전 게시판</a></li>
                    <li><a href="/boards/zvszboard" class="sc-menu-link sc-menu-link--zerg">15. 저저전 게시판</a></li>
                    <li><a href="/boards/pvstboard" class="sc-menu-link sc-menu-link--protoss">16. 프테전 게시판</a></li>
                    <li><a href="/boards/pvszboard" class="sc-menu-link sc-menu-link--protoss">17. 프저전 게시판</a></li>
                    <li><a href="/boards/pvspboard" class="sc-menu-link sc-menu-link--protoss">18. 프프전 게시판</a></li>
                    <li><a href="/boards/teamplayguideboard">19. 팀플 게시판</a></li>
                    <li><a href="/boards/tipboard" accesskey="t">20. 꿀팁보급고(T)</a></li>
                    <li><a href="/strategy-tips" accesskey="o">21. 한줄 공략(O)</a></li>
                </ul>
            </div>
        </fieldset>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 데스크톱은 두 메뉴를 펼치고 모바일은 커뮤니티만 펼친다.
    if(window.innerWidth > 768) {
        document.getElementById('basicMenuContent').style.display = "block";
        document.querySelector('#basicMenu .menu-toggle-hint').style.display = "none";
        document.getElementById('strategyMenuContent').style.display = "block";
        document.querySelector('#strategyMenu .menu-toggle-hint').style.display = "none";
    } else {
        // 모바일에서는 공략게시판을 접어 본문 접근을 빠르게 한다.
        document.querySelectorAll('.menu-content').forEach(function(menu) {
            var isBasicMenu = menu.id === 'basicMenuContent';
            menu.style.display = isBasicMenu ? "block" : "none";
            var hint = menu.previousElementSibling;
            if (hint && hint.classList.contains('menu-toggle-hint')) {
                hint.style.display = isBasicMenu ? "none" : "block";
            }
        });
    }
    syncMenuExpandedState();
});

function syncMenuExpandedState() {
    document.querySelectorAll('.menu-header[aria-controls]').forEach(function(button) {
        var menu = document.getElementById(button.getAttribute('aria-controls'));
        button.setAttribute('aria-expanded', String(menu.style.display === 'block'));
    });
}

function toggleMenu(menuId) {
    var menu = document.getElementById(menuId);
    var hint = menu.previousElementSibling; // 메뉴 토글 힌트 선택

    document.querySelectorAll('.menu-content').forEach(function(otherMenu) {
        if (otherMenu.id !== menuId) {
            otherMenu.style.display = 'none'; // 다른 메뉴 숨기기
            otherMenu.previousElementSibling.style.display = "block"; // 다른 메뉴의 힌트 보이기
        }
    });

    // 현재 클릭한 메뉴의 표시 상태 토글
    if (menu.style.display === "none" || menu.style.display === "") {
        menu.style.display = "block"; // 메뉴 보이기
        hint.style.display = "none"; // 힌트 숨기기
    } else {
        menu.style.display = "none"; // 메뉴 숨기기
        hint.style.display = "block"; // 힌트 보이기
    }
    syncMenuExpandedState();
}
</script>
